<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen live TV shrinking into the preview window (top right of the Live TV screen). -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:duration="280" android:interpolator="@android:interpolator/fast_out_slow_in">
    <scale android:fromXScale="1" android:toXScale="0.3" android:fromYScale="1" android:toYScale="0.3" android:pivotX="88%" android:pivotY="12%" />
    <alpha android:fromAlpha="1" android:toAlpha="0" android:startOffset="120" android:duration="160" />
</set>
